{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "demo-static-analyzer",
          "informationUri": "https://example.local/demo-static-analyzer",
          "rules": [
            {
              "id": "PY-CMD-INJECTION",
              "name": "Python command injection",
              "shortDescription": {
                "text": "User-controlled input reaches OS command execution."
              },
              "fullDescription": {
                "text": "Unsanitized request input flows into os.system, which can allow command injection."
              },
              "helpUri": "https://example.local/rules/PY-CMD-INJECTION",
              "properties": {
                "security-severity": "9.1",
                "precision": "high",
                "tags": [
                  "security",
                  "external/cwe/cwe-078"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-CMD-INJECTION",
          "level": "error",
          "message": {
            "text": "Request parameter cmd flows to os.system without validation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 5,
                  "endLine": 6,
                  "endColumn": 19
                }
              },
              "logicalLocations": [
                {
                  "name": "run_admin_command",
                  "kind": "function"
                }
              ]
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "message": {
                          "text": "Attacker-controlled request parameter is read."
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app.py"
                          },
                          "region": {
                            "startLine": 5,
                            "startColumn": 11,
                            "endLine": 5,
                            "endColumn": 30
                          }
                        }
                      }
                    },
                    {
                      "location": {
                        "message": {
                          "text": "The value is passed to os.system."
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app.py"
                          },
                          "region": {
                            "startLine": 6,
                            "startColumn": 5,
                            "endLine": 6,
                            "endColumn": 19
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "source": "request.args['cmd']",
            "sink": "os.system",
            "confidence": "demo-high"
          }
        }
      ]
    }
  ]
}
