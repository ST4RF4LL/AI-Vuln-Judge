{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "demo-static-analyzer",
          "informationUri": "https://example.local/demo-static-analyzer",
          "rules": [
            {
              "id": "PY-CMD-INJECTION",
              "name": "Python 命令注入",
              "shortDescription": {
                "text": "用户可控输入到达 OS 命令执行点。"
              },
              "fullDescription": {
                "text": "未经消毒的请求输入流入 os.system，可能导致命令注入。"
              },
              "helpUri": "https://example.local/rules/PY-CMD-INJECTION",
              "properties": {
                "security-severity": "9.1",
                "precision": "high",
                "tags": [
                  "security",
                  "external/cwe/cwe-078"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-CMD-INJECTION",
          "level": "error",
          "message": {
            "text": "请求参数 cmd 未经校验流入 os.system。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 5,
                  "endLine": 6,
                  "endColumn": 19
                }
              },
              "logicalLocations": [
                {
                  "name": "run_admin_command",
                  "kind": "function"
                }
              ]
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "message": {
                          "text": "读取攻击者可控的请求参数。"
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app.py"
                          },
                          "region": {
                            "startLine": 5,
                            "startColumn": 11,
                            "endLine": 5,
                            "endColumn": 30
                          }
                        }
                      }
                    },
                    {
                      "location": {
                        "message": {
                          "text": "该值被传递给 os.system。"
                        },
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "app.py"
                          },
                          "region": {
                            "startLine": 6,
                            "startColumn": 5,
                            "endLine": 6,
                            "endColumn": 19
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "source": "request.args['cmd']",
            "sink": "os.system",
            "confidence": "demo-high"
          }
        }
      ]
    }
  ]
}
