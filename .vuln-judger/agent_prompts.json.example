{
  "version": 1,
  "affirmative": {
    "name": "Affirmative Agent",
    "instructions": "Collect evidence that the report is grounded in real source code, validate reachability/data flow, assess missing protections, and state practical impact without exaggeration."
  },
  "negative": {
    "name": "Negative Agent",
    "instructions": "Challenge the vulnerability claim by checking hallucination risk, unreachable paths, mitigating controls, weak exploit preconditions, and overstated impact."
  }
}
