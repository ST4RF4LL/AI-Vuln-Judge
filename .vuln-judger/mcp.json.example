{
  "version": 1,
  "defaults": {
    "atlas": "atlas-default"
  },
  "servers": [
    {
      "id": "atlas-default",
      "name": "Atlas 默认 MCP",
      "transport": "stdio",
      "kind": "atlas",
      "command": "atlas",
      "args": [
        "mcp",
        "--log-format",
        "json"
      ],
      "cwd": "{project}",
      "env": {},
      "enabled": true,
      "description": "使用 Atlas v1.5+ MCP Focus 模式启动本地代码图 MCP Server；项目通过 cwd 或 project/open 激活。"
    }
  ]
}
